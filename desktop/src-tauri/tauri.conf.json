{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ApiDot",
  "version": "0.5.1",
  "identifier": "dev.hmedeiros.apidot",
  "build": {
    "beforeDevCommand": "node ../desktop/dev-server.js",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../frontend/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ApiDot",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https:; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/apidot-agent"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "apidot"
        ]
      }
    },
    "updater": {
      "pubkey": "REPLACE_WITH_GENERATED_ED25519_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/medeiroshudson/ApiDot/releases/latest/download/latest.json"
      ]
    }
  }
}
