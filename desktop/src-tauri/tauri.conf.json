{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ApiDot",
  "version": "0.5.1",
  "identifier": "dev.hmedeiros.apidot",
  "build": {
    "beforeDevCommand": "API_BASE_URL=https://apidot.hmedeiros.dev npm --prefix ../frontend run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../frontend/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ApiDot",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/apidot-agent"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_GENERATED_ED25519_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/medeiroshudson/ApiDot/releases/latest/download/latest.json"
      ]
    }
  }
}
