{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ApiDot",
  "version": "0.5.1",
  "identifier": "dev.hmedeiros.apidot",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../frontend/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ApiDot",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/apidot-agent"
    ]
  }
}
