# ==============================================================================
# ApiDot - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' at the repository root and customize your values.
# The '.env' file is strictly git-ignored to prevent credential exposure.
# ==============================================================================

# Application Version (fallback: dev)
APIDOT_VERSION=dev

# ------------------------------------------------------------------------------
# Authentication & Root Administrator
# ------------------------------------------------------------------------------
# Set to 'false' to enable offline/local bypass mode without login requirement
APIDOT_AUTH_ENABLED=true

# Set to 'false' if you want to strictly mandate SSO and disable local credentials
APIDOT_LOCAL_AUTH_ENABLED=true

# Root Administrator account email (used as primary anchor and account linking)
APIDOT_ROOT_EMAIL=contato@hmedeiros.dev

# Root Administrator local password (required if APIDOT_AUTH_ENABLED=true and local login is used)
APIDOT_ROOT_PASSWORD=ChangeMeStrongPassword123!

# ------------------------------------------------------------------------------
# OpenID Connect / SSO (e.g. Authentik, Keycloak, Okta)
# ------------------------------------------------------------------------------
# Base URL of the Identity Provider OpenID Connect application
# e.g. https://auth.hmedeiros.dev/application/o/apidot/
OIDC_AUTHORITY=

# Client ID registered in your Identity Provider
OIDC_CLIENT_ID=

# Client Secret registered in your Identity Provider (leave blank for public client PKCE if supported)
OIDC_CLIENT_SECRET=

# Requested OIDC Scopes (default: openid profile email)
OIDC_SCOPES=openid profile email

# ------------------------------------------------------------------------------
# Network & Service URLs
# ------------------------------------------------------------------------------
# Backend API base URL used by frontend rewrites (default: http://localhost:5000 in dev)
API_BASE_URL=http://localhost:5000
