{
  "name": "apidot-web",
  "version": "0.5.1",
  "private": true,
  "scripts": {
    "sync:assets": "node -e \"const fs=require('fs'),path=require('path'); const src=path.resolve(__dirname,'../assets'); const dst=path.resolve(__dirname,'assets'); if(fs.existsSync(src)){fs.mkdirSync(dst,{recursive:true}); for(const f of fs.readdirSync(src)){if(f.endsWith('.svg')) fs.copyFileSync(path.join(src,f),path.join(dst,f));}}\"",
    "predev": "npm run sync:assets",
    "prebuild": "npm run sync:assets",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "NODE_ENV=test vitest run",
    "test:e2e": "playwright test",
    "screenshots": "node playwright/capture-public-screenshots.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@uiw/react-codemirror": "^4.25.12",
    "lucide-react": "^1.16.0",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
